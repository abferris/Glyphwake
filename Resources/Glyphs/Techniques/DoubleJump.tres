[resource]
script = ExtResource("1_technique")
Costs = Array[ExtResource("2_cost")]([SubResource("GlyphCost_stamina")])
DisplayName = "Double Jump"
Description = "Press jump again while airborne to jump a second time, steering your arc slightly toward the held direction. Points buy more mid-air jumps -- one every 10 points, each starting at half a normal jump's height and reaching twice it over its decade -- and spend less stamina. The chain resets when you land."
Icon = ExtResource("6_n0lv8")
CastAnimation = SubResource("GlyphCastAnimation_airstep")
BaseStats = Array[ExtResource("3_statvalue")]([SubResource("StatValue_jumpcount")])
Scalings = Array[ExtResource("4_scaling")]([SubResource("GlyphScaling_jumpcount")])
Elements = Array[int]([4, 5])
